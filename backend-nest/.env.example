# ─── Database ───
# Copy this file to `.env` and update values as needed.
DATABASE_URL="mysql://root:password@localhost:3306/sdu_admin"

# ─── Server ───
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ─── Auth (JWT) ───
# Generate a strong secret: `openssl rand -hex 32`
JWT_SECRET=replace-this-with-a-long-random-secret-string-min-32-chars
JWT_EXPIRES_IN=7d

# ─── File uploads ───
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ─── Bootstrap (optional) ───
# When set to "true", the seeder runs automatically on startup.
SEED_ON_BOOT=false
